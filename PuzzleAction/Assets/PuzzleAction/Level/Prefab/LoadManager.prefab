  m_panel: {fileID: 400609570698515970}
  m_tipsText: {fileID: 1974380271163311008}
  m_tips:
  - "\u708E\u3001\u6BD2\u3001\u30AC\u30B9 \u306E\u30D0\u30D5\u30C0\u30E1\u30FC\u30B8\u306F
    HP\uFF11\u6B8B\u308A\u307E\u3059"
  - "\u30A2\u30A4\u30C6\u30E0\u306E[\u30C0\u30A4\u30CA\u30DE\u30A4\u30C8]\u3000[\u3051\u304A\u3069\u3057\u7206\u5F3E]\u306F\u3000\u4F7F\u7528\u8005\u3082\u3000\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u307E\u3059"
  - "\u7279\u5B9A\u306E\u30A2\u30A4\u30C6\u30E0\u3092\u63C3\u3048\u3066\u6301\u3063\u3066\u304A\u304F\u3068\u3044\u3044\u3053\u3068\u304C...\uFF1F"
  - "\u30DE\u30C3\u30D7\u30D4\u30FC\u30B9\u8A2D\u7F6E\u306F \u30B9\u30BF\u30FC\u30C8\u5730\u70B9\u306B
    \u5371\u967A\u3092\u7F6E\u304B\u306A\u3044\u3088\u3046\u6C17\u3092\u4ED8\u3051\u307E\u3057\u3087\u3046"
  - "\uFF15\u968E\u5C64\u3054\u3068\u306B\u30DC\u30B9\u304C\u304A\u308A\u3001\u5012\u3055\u306A\u3044\u3068\u30B4\u30FC\u30EB\u306F\u3067\u304D\u307E\u305B\u3093"
  - "\u30DE\u30C3\u30D7\u30D4\u30FC\u30B9\u3092\u591A\u304F\u8A2D\u7F6E\u3059\u308B\u3068\u3001\u5B9D\u7BB1\u3082\u305F\u304F\u3055\u3093\u51FA\u73FE\u3057\u307E\u3059"
